@@ -227,6 +227,13 @@ def singularize(word):
         singular = word[:-3] + 'y'
     elif word.endswith('es') and word[-3] == 's':
         singular = word[:-2]
+    elif word.endswith('ss'):
+        # Words ending in a double 's' (glass, boss, kiss) are already
