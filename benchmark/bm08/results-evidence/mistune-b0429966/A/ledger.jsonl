{"event_id":"843245f826134635","kind":"changeset_registered","payload":{"attempt":1,"changeset":{"attempt":1,"diff":"--- a/src/mistune/renderers/markdown.py\n+++ b/src/mistune/renderers/markdown.py\n@@ -13,8 +13,11 @@ fenced_re = re.compile(r\"^[`~]+\", re.M)\n _backtick_run_re = re.compile(r\"`+\")\n \n #: leading markers that would be parsed as a new block (list, heading, block\n #: quote) if they appear unescaped at the start of a line.\n _block_prefix_re = re.compile(r\"^(\\s*)(>|[-+*]|#{1,6}|\\d{1,9}[.)])(\\s|$)\")\n+\n+#: emphasis/strong delimiters that must be backslash-escaped in plain text\n+_emphasis_re = re.compile(r\"[*_]\")\n \n \n class MarkdownRenderer(BaseRenderer):\n@@ -49,5 +52,8 @@ class MarkdownRenderer(BaseRenderer):\n \n     def text(self, token: Dict[str, Any], state: BlockState) -> str:\n         # a backtick always opens a code span, so it must stay escaped to\n         # survive a re-parse as literal text.\n-        return cast(str, token[\"raw\"]).replace(\"`\", \"\\\\`\")\n+        raw = cast(str, token[\"raw\"])\n+        raw = raw.replace(\"`\", \"\\\\`\")\n+        raw = _emphasis_re.sub(lambda m: \"\\\\\" + m.group(0), raw)\n+        return raw\n","origin":"model","patch_hash":"1c496df58396a0f01392caba0a410150f6cd6144301917f67c2a5e0361e774e1","touched_paths":["src/mistune/renderers/markdown.py"]},"summary_not_evidence":"Escape `*` and `_` characters in the MarkdownRenderer text method so that emphasis delimiters in plain text tokens are re-emitted with backslash escapes, preventing them from being re-parsed as emphas"},"schema_version":1,"seq":21,"task_id":"fix-633fd661-0000","ts":"2026-08-24T03:04:20.906560Z"}
