{"event_id":"c013032c5702cbaa","kind":"changeset_registered","payload":{"attempt":1,"changeset":{"attempt":1,"diff":"--- a/click/decorators.py\n+++ b/click/decorators.py\n@@ -151,10 +151,11 @@ def option(*param_decls, **attrs):\n     \"\"\"Attaches an option to the command.  All positional arguments are\n     passed as parameter declarations to :class:`Option`; all keyword\n     arguments are forwarded unchanged (except ``cls``).  This is equivalent\n     to creating an :class:`Option` instance manually and attaching it to the\n     :attr:`Command.params` list.\n     \"\"\"\n-    def decorator(f):\n-        option_attrs = attrs.copy()\n+    option_attrs = attrs.copy()\n+    def decorator(f):\n+        option_attrs_copy = option_attrs.copy()\n         if 'help' in option_attrs:\n             option_attrs['help'] = inspect.cleandoc(option_attrs['help'])\n-        Option = option_attrs.pop('cls', core.Option)\n-        _param_memo(f, Option(param_decls, **option_attrs))\n+        if 'help' in option_attrs_copy:\n+            option_attrs_copy['help'] = inspect.cleandoc(option_attrs_copy['help'])\n+        Option = option_attrs_copy.pop('cls', core.Option)\n+        _param_memo(f, Option(param_decls, **option_attrs_copy))\n         return f\n     return decorator\n","origin":"model","patch_hash":"c5f950cefc8570a32896301aa66db274f9c2d15be4dd83aeac2d103e3341de53","touched_paths":["click/decorators.py"]},"summary_not_evidence":"Fix click.option decorator reuse by copying attrs inside the decorator function each time it is called, so that mutations like popping 'cls' don't affect subsequent uses."},"schema_version":1,"seq":21,"task_id":"fix-c7bd95c8-0000","ts":"2026-08-24T03:09:09.303102Z"}
