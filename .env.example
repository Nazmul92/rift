# BM-06 provider configuration — template. Copy to `.env` and fill in the key.
#
# `.env` is git-ignored and is NEVER read by the riftagent runtime. The runtime
# reads only the three process environment variables below, exactly as design
# §4 requires; nothing in src/ parses this file. It is a convenience for the
# operator, loaded explicitly before a benchmark run:
#
#     set -a; . ./.env; set +a          # POSIX
#     Get-Content .env | ForEach-Object { ... }   # PowerShell, see USAGE
#
# The key must never reach source, prompts, context, logs, ledger events,
# receipts, manifests, or any repository subprocess. The env allowlist in
# sandbox.py already excludes RIFT_LLM_* from every child process; keeping the
# secret out of this file's siblings is the operator's half of that.

RIFT_LLM_KEY=paste-your-anthropic-api-key-here

# Anthropic's OpenAI-compatible Chat Completions endpoint. UNVERIFIED until the
# BM-06 smoke test runs — the exact base path is the one value here I could not
# confirm from documentation, so the smoke request checks it before any
# benchmark spend.
RIFT_LLM_URL=https://api.anthropic.com/v1/chat/completions

# Cheapest current Claude model: $1.00 / $5.00 per million input / output
# tokens. Verified against the model catalog on 2026-08-15.
RIFT_LLM_MODEL=claude-haiku-4-5
